{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": ".git/*", "effect": "ask" },
    { "action": "edit", "resource": "*/.git/*", "effect": "ask" },
    { "action": "edit", "resource": "*.env", "effect": "ask" },
    { "action": "edit", "resource": "*.env.*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs*", "effect": "ask" },
    { "action": "shell", "resource": "wipefs*", "effect": "ask" },
    { "action": "shell", "resource": "fdisk*", "effect": "ask" },
    { "action": "shell", "resource": "parted*", "effect": "ask" },
    { "action": "shell", "resource": "sgdisk*", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "shutdown*", "effect": "ask" },
    { "action": "shell", "resource": "reboot*", "effect": "ask" },
    { "action": "shell", "resource": "poweroff*", "effect": "ask" },
    { "action": "shell", "resource": "halt*", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker volume rm*", "effect": "ask" }
  ],
  "policies": [
    { "action": "tool.use", "resource": "read:*/.ssh/id_*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.ssh/*.pub", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*/.aws/credentials", "effect": "deny" }
  ],
  "providers": {

    "newapi": {
      "name": "New API",
      // 凭据优先由 /connect 保存；也可通过该环境变量提供
      "env": ["NEWAPI_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.rgna.cc:20043/v1"
      },
      "models": {
        "ornith1.5": {
          "name": "ornith1.5 (New API)",
          "capabilities": { "tools": true },
          "limit": { "context": 83000, "output": 16000 }
        },
        "qwen3.8-27b": {
          "name": "qwen3.8 (New API)",
          "capabilities": { "tools": true },
          "limit": { "context": 128000, "output": 16000 }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 13000 },
    "buffer": "10%"
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 40960
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/dist/**",
      "**/build/**"
    ]
  }
}
