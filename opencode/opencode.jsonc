{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "cd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "cat *": "allow",
      "bat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "env": "allow",
      "printenv *": "allow",
      "date*": "allow",
      "whoami": "allow",
      "id": "allow",
      "uname*": "allow",
      "hostname": "allow",
      "uptime": "allow",
      "which *": "allow",
      "whereis *": "allow",
      "type *": "allow",
      "command -v *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ag *": "allow",
      "cut *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "tr *": "allow",
      "sed -n *": "allow",
      "awk *": "allow",
      "diff *": "allow",
      "comm *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git stash list*": "allow",
      "git reflog*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git describe*": "allow",
      "git ls-files*": "allow",
      "git shortlog*": "allow",
      "git remote -v": "allow",
      "git remote show*": "allow",
      "git config --get*": "allow",
      "git config --list*": "allow",
      "git branch": "allow",
      "git branch -a": "allow",
      "git branch -v": "allow",
      "git branch -vv": "allow",
      "git branch --list*": "allow",
      "git tag -l*": "allow",
      "git tag --list*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "npm run typecheck*": "allow",
      "npm run check*": "allow",
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pnpm build*": "allow",
      "yarn test*": "allow",
      "yarn lint*": "allow",
      "yarn build*": "allow",
      "bun test*": "allow",
      "bun run test*": "allow",
      "bun run lint*": "allow",
      "bun run build*": "allow",
      "cargo test*": "allow",
      "cargo build*": "allow",
      "cargo check*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt*": "allow",
      "go test*": "allow",
      "go build*": "allow",
      "go vet*": "allow",
      "go fmt*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "python -m unittest*": "allow",
      "python -m mypy*": "allow",
      "ruff": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "flake8 *": "allow",
      "black --check*": "allow",
      "pylint *": "allow",
      "tsc*": "allow",
      "eslint *": "allow",
      "prettier --check*": "allow",
      "make test*": "allow",
      "make check*": "allow",
      "make build*": "allow"
    }
  },
  "plugin": [
    "opencode-visual-cache"
  ],
  "provider": {
    "sense-nova": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Sense Nova",
      "options": {
        "baseURL": "https://token.sensenova.cn/v1",
        "apiKey": "{env:SENSENOVA_API_KEY}"
      },
      "models": {
        "sensenova-6.8-flash-lite": {
          "name": "SenseNova 6.8 Flash-Lite",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 256000,
            "output": 65536
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  }
}
