{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "/var/tmp/*": "allow"
    },
    "edit": {
      "*": "allow",
      ".git/**": "ask",
      "**/.git/**": "ask"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask"
    }
  },
  "plugin": [
    "opencode-visual-cache"
  ],
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:22233/v1"
      },
      "models": {
        "qwen3.8-27B.gguf": {
          "name": "Qwen 3.8-27B (local)",
          "tool_call": true,
          "limit": {
            "context": 65535,
            "output": 32768
          }
        },
        "ornith1.5-9B.gguf": {
          "name": "ornith1.5 (local)",
          "tool_call": true,
          "limit": {
            "context": 80000,
            "output": 65535
          }
        }
      }
    }
  }
}
