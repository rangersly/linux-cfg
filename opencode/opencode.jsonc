{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "allow"
    },
    "edit": {
      "*": "allow",
      "/*": "ask",
      "/tmp/*": "allow",
      "/var/tmp/*": "allow",
      "~/.config/opencode/*": "allow",
      ".git/**": "ask",
      "**/.git/**": "ask"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git push *": "ask",
      "mkfs*": "ask",
      "wipefs*": "ask",
      "fdisk*": "ask",
      "parted*": "ask",
      "sgdisk*": "ask",
      "dd *": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "poweroff*": "ask",
      "halt*": "ask",
      "docker system prune*": "ask",
      "docker volume rm*": "ask"
    }
  },
  "plugin": [
    "./bash-guard.ts"
  ],
  "experimental": {
    "continue_loop_on_deny": true
  },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:22233/v1"
      },
      "models": {
        "ornith1.5-9B.gguf": {
          "name": "ornith1.5 (local)",
          "tool_call": true,
          "limit": {
            "context": 70000,
            "output": 32768
          }
        }
      }
    }
  }
}
